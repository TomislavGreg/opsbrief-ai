# Copy to .env and fill in local values. Never commit the real .env file.

# Application
OPSBRIEF_APP_NAME=OpsBrief AI
OPSBRIEF_ENVIRONMENT=development
OPSBRIEF_LOG_LEVEL=info

# Storage. SQLite is the default for local development.
OPSBRIEF_DATABASE_URL=sqlite:///./opsbrief.db

# AI provider. "deterministic" (the default) composes summaries from the
# structured picture offline, with no model or key; "fake" is the scripted test
# provider. An unknown name is refused at startup.
OPSBRIEF_AI_PROVIDER=deterministic

# Demo data. When true, the service seeds a fresh (empty) store with synthetic
# match-day events and a worked incident on startup, so a public demo shows a
# populated dashboard without anyone posting events. It never touches a store
# that already holds events. Leave false for a real deployment.
OPSBRIEF_DEMO_DATA=false

# Read-only mode. When true, every write route (event and batch ingestion,
# incident declaration and mutation, and the webhook) is refused with 403 while
# reads keep working, so the service can be exposed as a read-only demo. Demo-data
# mode turns this on by default. Leave false for a deployment that accepts writes.
OPSBRIEF_READ_ONLY=false

# Redaction. Extra metadata key terms whose values are masked before storage,
# comma-separated. These add to the built-in set (email, phone, token, ...).
OPSBRIEF_REDACT_METADATA_KEYS=

# AI context. Event fields held back from the material the model is shown,
# comma-separated. Choose from: source, event_type, subject, severity, status,
# occurred_at. Empty excludes nothing.
OPSBRIEF_AI_CONTEXT_EXCLUDED_FIELDS=

# Webhook ingestion. Shared secret for HMAC verification of POST /webhooks/events.
# Unset disables the webhook; when set it must be at least 16 characters. Never
# commit the real secret.
OPSBRIEF_WEBHOOK_SECRET=

# Allowed clock skew, in seconds, for the signed webhook timestamp. Defaults to
# 300 (five minutes).
OPSBRIEF_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
