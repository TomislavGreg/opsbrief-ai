# Copy to .env and fill in local values. Never commit the real .env file.

# Application
OPSBRIEF_APP_NAME=OpsBrief AI
OPSBRIEF_ENVIRONMENT=development
OPSBRIEF_LOG_LEVEL=info

# Storage. SQLite is the default for local development.
OPSBRIEF_DATABASE_URL=sqlite:///./opsbrief.db

# AI provider. Only "fake" is implemented so far; it needs no model or key.
OPSBRIEF_AI_PROVIDER=fake

# Redaction. Extra metadata key terms whose values are masked before storage,
# comma-separated. These add to the built-in set (email, phone, token, ...).
OPSBRIEF_REDACT_METADATA_KEYS=
